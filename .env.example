# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated hostnames (no https://). Example for Render:
# DJANGO_ALLOWED_HOSTS=finsight-api.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon / Render Postgres / any Postgres URL)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Redis (optional). Leave empty to use in-memory cache (fine for MVP on Render free).
REDIS_URL=
CELERY_BROKER_URL=

# CORS / CSRF — your Vercel frontend origin(s), comma-separated, with https://
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Behind Render's TLS proxy
SECURE_SSL_REDIRECT=True

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption (optional — generate with Fernet.generate_key())
FIELD_ENCRYPTION_KEY=

# LLM (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Sentry (optional)
SENTRY_DSN=
